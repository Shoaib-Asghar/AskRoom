# Required: Google AI Studio API key for Gemini LLM and embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Cohere API key for reranking (gracefully skipped if missing)
COHERE_API_KEY=

# Embedding Model (defaults to gemini-embedding-2 for multimodal embeddings)
EMBEDDING_MODEL=gemini-embedding-2

# Server config
PORT=3005
CLIENT_URL=http://localhost:3000
